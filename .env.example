# ---------------------------------------------------------------
# Everything is OPTIONAL. The crawler, scoring, tracker and resume
# exports all work with zero environment variables set.
# ---------------------------------------------------------------

# Resume tailoring, cover notes, referral DMs, interview briefs.
# Get a key at console.anthropic.com. Stays server-side, never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Push new matches to your phone. Create a bot with @BotFather,
# then message it once and read your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protects /api/cron. Set this in production and add the same value
# to the GitHub Actions secret if you use the workflow.
CRON_SECRET=

# Your deployed URL, used in the Telegram digest footer.
APP_URL=

# Only jobs scoring at or above this get pushed. Default 55.
MIN_SCORE=55

# Without a KV store the cron dedupes by posting age. Default 26 hours.
SCAN_WINDOW_HOURS=26

# Optional: Upstash / Vercel KV for exact dedupe and server-side sources.
KV_REST_API_URL=
KV_REST_API_TOKEN=
